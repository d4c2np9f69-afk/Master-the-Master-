#!/bin/sh
# HCC — run the kitchen wall panel LIKE THE iPAD: the app is simply up, all the time.
# Jeff, 2026-09-23: "I would like to run the HP like the iPad does with the app up all the time."
# 2026-09-24: moved from Chrome to FIREFOX (OPEN_ITEMS #205: Chrome on this machine's GPU
# hard-reset it; Jeff: "remove chrome completely"). Firefox equivalents of the three choices:
#   --kiosk + policy dom.allow_scripts_to_close_windows=true  -> the app's own X closes it
#   the NORMAL Firefox profile (no --profile)                  -> the HA login is remembered
#   ?kiosk=1&rot=60                                            -> the app rotates, no burn-in
export DISPLAY="${DISPLAY:-:0}"
sleep 20                                   # let the desktop and network settle first
pgrep -f 'loewenhome\.com/\?kiosk=1' >/dev/null 2>&1 && exit 0
exec firefox --kiosk 'https://loewenhome.com/?kiosk=1&rot=60'
