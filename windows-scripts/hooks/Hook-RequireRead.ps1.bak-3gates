<#
  HCC READ GATE - PreToolUse on Bash|PowerShell|Edit|Write

  HARD BLOCK: a session may not CHANGE a subsystem until it has READ that
  subsystem's files IN THIS SESSION. Not "should". Cannot.

  WHY, AND WHY IT COVERS THESE TOOLS (2026-09-09):
  Hook-GuardProtected.ps1 matched only Edit|Write. On the night of 2026-09-09 a
  session spent six hours on the camera stack and changed two automations,
  restarted HA twice, renamed a custom component and edited its manifest -
  ALL THROUGH Bash/PowerShell AND THE BROWSER. The guard never fired once. It
  had been guarding the one door nobody used. Jeff, that night:
      "put hard rules that can't be broken"
  and, on being told to make it optional and be nice by an earlier session:
      "I've tried everything to just get the sessions to read the files"

  The read was never the hard part. The gate is.

  Reads are NEVER blocked. Only mutations. If Jeff needs to move fast he can
  say the override phrase and it stands down for that call.
#>
$ErrorActionPreference = 'SilentlyContinue'

$raw = [Console]::In.ReadToEnd()
try { $j = $raw | ConvertFrom-Json } catch { exit 0 }

# ---- what is this call trying to do? ----
$blob = @(
  "$($j.tool_input.command)"
  "$($j.tool_input.file_path)"
  "$($j.tool_input.content)"
  "$($j.tool_input.new_string)"
) -join ' '
if (-not $blob.Trim()) { exit 0 }

# ---- Jeff's escape hatch. His house, his call. ----
if ($blob -match '(?i)HCC-OVERRIDE') { exit 0 }

# ---- Does it MUTATE? Reading, grepping and listing are always allowed. ----
$MUTATES = @(
  '/api/services/', 'api/config/automation', 'config_entries',
  'turn_on', 'turn_off', 'homeassistant/restart', 'reload_config_entry',
  'trigger_camera', 'save_video', 'save_recent_clips',
  'Remove-Item', 'Set-Content', 'Out-File', '\bmv\b', '\brm\b', '\bcp\b',
  'Restart-Service', 'Stop-Service', 'Start-ScheduledTask',
  'Disable-ScheduledTask', 'Enable-ScheduledTask'
)
$isMutation = $false
foreach ($m in $MUTATES) { if ($blob -match $m) { $isMutation = $true; break } }
# Edit/Write are mutations by definition.
if ("$($j.tool_name)" -match '^(Edit|Write|NotebookEdit)$') { $isMutation = $true }
if (-not $isMutation) { exit 0 }

# ---- Which subsystem does it touch, and what must be read first? ----
# Keep this list SHORT and load-bearing. A gate nobody can satisfy gets deleted.
$GATES = @(
  @{ Name     = 'CAMERAS / BLINK'
     Match    = 'blink|camera|go2rtc|homekit|image_processing|pipup|clipframe|ai_snapshot'
     Requires = @('CAMERAS_CLOSED_2026-08-22.md', 'camera_fixes_2026-08-21.md')
     Why      = 'Cameras are FROZEN. 2026-09-09 cost six hours because these two files went unread: the 307 "System is busy" lockout signature and the DO-NOT-UNDO HomeKit repoint are both written in them.' }
  @{ Name     = 'GARAGE DOOR'
     Match    = 'garage'
     Requires = @('OPEN_ITEMS.md')
     Why      = '#168 carries the Chamberlain 41AC050-2M terminal map. On 2026-09-09 a session told Jeff to REMOVE the wire that was fixing his photo eyes.' }
  @{ Name     = 'HA CORE UPDATE'
     Match    = 'home_assistant_core_update|core[_ ]update|ha core update'
     Requires = @('OPEN_ITEMS.md')
     Why      = '2026-09-04: a core update went in without reading the release notes, broke blink + alexa_media on Python 3.14, and had to be rolled back.' }
)

$sid = "$($j.session_id)"; if (-not $sid) { $sid = 'nosession' }
$sid = ($sid -replace '[^A-Za-z0-9\-_]', '')
$receipt = Join-Path $env:TEMP ("hcc-read-" + $sid + ".txt")
$readSoFar = ''
if (Test-Path $receipt) { $readSoFar = (Get-Content -LiteralPath $receipt -Raw) }

function Deny($name, $missing, $why) {
  $list = ($missing | ForEach-Object { "        $_" }) -join "`n"
  $reason = @"
BLOCKED - YOU HAVE NOT READ THE $name FILES IN THIS SESSION.

This is a mechanical gate, not a suggestion. It fired because you tried to
CHANGE something before reading what is already known about it.

READ THESE FIRST (use the Read tool - grep does not count):
$list

WHY THIS GATE EXISTS:
    $why

Jeff, 2026-09-09: "I've tried everything to just get the sessions to read the
files before they act." Every soft version of this rule has been violated. His
own case study to Anthropic concluded: "Rules that depend on a session choosing
to read them do not survive session boundaries."

An empty grep is NOT evidence of absence. Read the whole file.
If Jeff explicitly tells you to skip this, include HCC-OVERRIDE in the command.
"@
  @{
    hookSpecificOutput = @{
      hookEventName            = 'PreToolUse'
      permissionDecision       = 'deny'
      permissionDecisionReason = $reason
    }
    systemMessage = "HCC READ GATE BLOCKED THIS - $name files unread this session"
  } | ConvertTo-Json -Depth 5 -Compress | Write-Output
  exit 0
}

foreach ($g in $GATES) {
  if ($blob -match "(?i)$($g.Match)") {
    $missing = @()
    foreach ($doc in $g.Requires) {
      if ($readSoFar -notmatch [regex]::Escape($doc)) { $missing += $doc }
    }
    if ($missing.Count -gt 0) { Deny $g.Name $missing $g.Why }
  }
}

exit 0
