# ESPHome secrets — copy this to /config/esphome/secrets.yaml on Beehive
# Fill in your values. This file is NEVER committed to git.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Generate a random 32-byte base64 key: openssl rand -base64 32
esphome_api_key: "REPLACE_WITH_GENERATED_KEY"

# Strong password for OTA updates and fallback AP
esphome_ota_password: "REPLACE_WITH_STRONG_PASSWORD"
